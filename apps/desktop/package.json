{
  "name": "@substrate/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The connected Substrate desktop workspace",
  "author": "Substrate",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "setup": "install-electron",
    "dev": "bun run setup && bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:dir": "bun run build && electron-builder --win --dir",
    "package": "bun run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "test": "bun test src scripts"
  },
  "dependencies": {
    "@better-auth/electron": "^1.7.18",
    "@substrate/client-storage": "workspace:*",
    "@substrate/contracts": "workspace:*",
    "@substrate/harness-runtime": "workspace:*",
    "better-auth": "^1.7.18",
    "conf": "^16.0.0",
    "croner": "^11",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/ws": "^8.18.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.substrate.desktop",
    "productName": "Substrate",
    "directories": {
      "app": "dist",
      "output": "release"
    },
    "files": [
      "**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "harness-worker-entry.mjs",
      "client-storage-migrations/**",
      "node_modules/**/*"
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "Substrate",
        "schemes": [
          "substrate"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "Substrate"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

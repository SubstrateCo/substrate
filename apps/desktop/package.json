{
  "name": "@substrate/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The connected Substrate desktop workspace",
  "author": "Substrate",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "install-electron && bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:dir": "bun run build && electron-builder --win --dir",
    "package": "bun run package:win",
    "package:win": "bun run build && electron-builder --win nsis --publish never",
    "package:mac": "bun run build && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit",
    "test": "bun test src scripts"
  },
  "dependencies": {
    "@better-auth/electron": "catalog:auth",
    "@substrate/client-storage": "workspace:*",
    "@substrate/contracts": "workspace:*",
    "@substrate/harness-runtime": "workspace:*",
    "better-auth": "catalog:auth",
    "conf": "^16.0.0",
    "croner": "^11",
    "electron-updater": "^6.8.11",
    "ws": "^8.22.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:tooling",
    "@types/ws": "^8.18.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "catalog:tooling"
  },
  "build": {
    "appId": "com.substrate.desktop",
    "productName": "Substrate",
    "directories": {
      "app": "dist",
      "output": "release"
    },
    "files": [
      "**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "harness-worker-entry.mjs",
      "client-storage-migrations/**",
      "node_modules/**/*"
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "Substrate",
        "schemes": [
          "substrate"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "SubstrateCo",
      "repo": "substrate",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "Substrate"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-mac-${arch}.${ext}"
    }
  }
}

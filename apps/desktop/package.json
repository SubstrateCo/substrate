{
  "name": "@startup-os/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The connected Startup OS desktop workspace",
  "author": "Startup OS",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "setup": "install-electron",
    "dev": "bun run setup && bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:dir": "bun run build && electron-builder --win --dir",
    "package": "bun run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "test": "bun test src scripts",
    "test:e2e": "bun run setup && bun scripts/preload.ts && playwright test"
  },
  "dependencies": {
    "@better-auth/electron": "^1.7.18",
    "@startup-os/contracts": "workspace:*",
    "@startup-os/harness-runtime": "workspace:*",
    "better-auth": "^1.7.18",
    "conf": "^16.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.startupos.desktop",
    "productName": "Startup OS",
    "directories": {
      "app": "dist",
      "output": "release"
    },
    "files": [
      "**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "harness-worker-entry.mjs",
      "harness-migrations/**",
      "node_modules/**/*"
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "Startup OS",
        "schemes": [
          "startupos"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "Startup OS"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

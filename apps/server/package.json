{
  "name": "@substrate/server",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun --env-file=../../.env src/main.ts",
    "load": "DATABASE_URL=postgres://substrate_load:substrate_load@localhost:5435/substrate_load bun --no-env-file scripts/start-load.ts",
    "load:provision": "bun --no-env-file load/provision.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env test src scripts load",
    "test:integration": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@better-auth/electron": "^1.7.18",
    "@hono/bun": "^1.0.1",
    "@hono/zod-validator": "^0.7.6",
    "@substrate/contracts": "workspace:*",
    "@substrate/database": "workspace:*",
    "better-auth": "^1.7.18",
    "csv-stringify": "^6.9.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.10.0",
    "nodemailer": "^10.3.1",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/k6": "^1.4.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}

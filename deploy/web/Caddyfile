{
	admin off
	auto_https off
	persist_config off
	servers {
		# Railway's edge terminates TLS and connects from these ranges.
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

:{$PORT} {
	encode zstd gzip

	@backend path /api /api/* /desktop /desktop/*
	handle @backend {
		reverse_proxy {$API_UPSTREAM}
	}

	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options SAMEORIGIN
		}
		# Vite fingerprints /assets; everything else must revalidate after a deploy.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control no-cache

		# Extensionless workspace routes use SPA history. Missing assets stay 404.
		@route {
			not file
			not path_regexp \.[A-Za-z0-9]+$
		}
		rewrite @route /index.html
		file_server
	}
}

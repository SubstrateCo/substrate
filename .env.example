DATABASE_URL=postgres://substrate:substrate@localhost:5432/substrate
VALKEY_URL=redis://localhost:6379
# Separates servers that share one Valkey, such as the e2e and development servers.
# REALTIME_CHANNEL=substrate:realtime:v1
# Opt-in Valkey fan-out test. Unit tests skip it when this is unset.
TEST_VALKEY_URL=redis://localhost:6379
TEST_DATABASE_URL=postgres://substrate_test:substrate_test@localhost:5433/substrate_test
# Public API origin: auth links, the Vite proxy target and the desktop backend.
# Required when building the desktop app.
SUBSTRATE_API_URL=http://localhost:3001
# Public web app origin: email links, the Vite port and desktop browser sign-in.
# Required when building the desktop app.
SUBSTRATE_WEB_URL=http://localhost:3000
# The server binds SUBSTRATE_API_URL's port. Set this when a proxy serves that origin.
# SERVER_PORT=3001
# Extra trusted frontend origins, comma separated. The web app and the desktop renderer are
# always trusted.
# FRONTEND_ORIGINS=
# Public HTTPS URL of the published Windows installer. Setup works without it.
# SUBSTRATE_WINDOWS_DOWNLOAD_URL=https://downloads.example.com/Substrate.exe
# Generate a random secret of at least 32 characters before starting the app.
BETTER_AUTH_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="Substrate <noreply@substrate.local>"
# SMTP_USER=
# SMTP_PASSWORD=

# Private S3-compatible storage. These values are also the non-production defaults. The desktop
# app permits direct signed uploads only to S3_ENDPOINT's origin.
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=substrate-private
S3_ACCESS_KEY_ID=substrate
S3_SECRET_ACCESS_KEY=substrate_storage


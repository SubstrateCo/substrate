DATABASE_URL=postgres://startup_os:startup_os@localhost:5432/startup_os
TEST_DATABASE_URL=postgres://startup_os_test:startup_os_test@localhost:5433/startup_os_test
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,https://desktop.startup-os.local
SERVER_PORT=3001
WEB_PORT=3000
# Vite's browser API proxy target. Electron uses STARTUP_OS_API_URL.
SERVER_URL=http://localhost:3001
STARTUP_OS_API_URL=http://localhost:3001
# Public browser sign-in origin. Required when building the desktop app.
STARTUP_OS_WEB_URL=http://localhost:3000
# Generate a random secret of at least 32 characters before starting the app.
BETTER_AUTH_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="Startup OS <noreply@startup-os.local>"
# SMTP_USER=
# SMTP_PASSWORD=

# Private S3-compatible storage. These values are also the non-production defaults.
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=startup-os-private
S3_ACCESS_KEY_ID=startup_os
S3_SECRET_ACCESS_KEY=startup_os_storage
# Electron permits direct signed uploads only to these explicit storage origins.
STARTUP_OS_STORAGE_ORIGINS=http://localhost:4566

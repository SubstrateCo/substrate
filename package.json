{
  "name": "substrate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @substrate/desktop dev",
    "dev:server": "bun run --filter @substrate/server dev",
    "dev:web": "bun run --filter @substrate/web dev",
    "dev:avatars": "bun run --filter @substrate/agent-avatars dev",
    "dev:mobile": "bun run --filter @substrate/mobile dev",
    "dev:mobile:android": "bun run --filter @substrate/mobile dev:android",
    "dev:mobile:ios": "bun run --filter @substrate/mobile dev:ios",
    "dev:mobile:web": "bun run --filter @substrate/mobile dev:web",
    "typecheck:mobile": "turbo run typecheck --filter=@substrate/mobile",
    "test:mobile": "turbo run test --filter=@substrate/mobile",
    "capture:mobile": "turbo run capture --filter=@substrate/mobile --",
    "tokens:generate": "bun tooling/design-tokens/src/cli.ts",
    "tokens:check": "bun tooling/design-tokens/src/cli.ts --check",
    "test:mobile-tooling": "turbo run test --filter=@substrate/design-token-tooling --filter=@substrate/mobile-lint",
    "build": "bun run --filter @substrate/desktop build",
    "package:desktop": "bun run --filter @substrate/desktop package",
    "test:integration": "bun run --filter @substrate/server test:integration",
    "test:e2e": "turbo run test:e2e --filter=@substrate/web",
    "services:up": "docker compose up -d --wait postgres mailpit s3 s3-init valkey",
    "services:test": "docker compose --profile test up -d --wait postgres-test postgres-e2e mailpit valkey s3 s3-init",
    "lint": "bun run tokens:check && oxlint --type-aware --fix",
    "knip": "knip",
    "dup:check": "jscpd --fail-on-new-clones --reporters ai",
    "dup:baseline": "jscpd --update-baseline --reporters silent",
    "format": "oxfmt --write .",
    "format:files": "oxfmt --write",
    "typecheck": "turbo run typecheck",
    "test": "bun --env-file=.env scripts/check-test-services.ts && turbo run test",
    "db:generate": "bun run --filter @substrate/database db:generate",
    "db:migrate": "bun run --filter @substrate/database db:migrate",
    "db:seed": "bun --env-file=.env apps/server/scripts/seed-dev.ts",
    "evals": "bun --env-file=.env tooling/agent-evals/src/cli.ts",
    "evals:trace": "bun tooling/agent-evals/src/trace.ts",
    "evals:models": "bun tooling/agent-evals/src/models.ts"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.5",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/bun": "catalog:tooling",
    "ai-deslop": "^0.7.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jscpd": "^5",
    "knip": "^6.44.2",
    "oxfmt": "^0.79.0",
    "oxlint": "catalog:tooling",
    "railway": "3.17.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "turbo": "^2.11.10"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "hono": "^4.10.0",
    "zod": "^4.6.7"
  },
  "catalogs": {
    "tooling": {
      "@playwright/test": "^1.64.1",
      "@types/bun": "^1.4.4",
      "@types/node": "24.19.2",
      "oxlint": "^1.94.0"
    },
    "auth": {
      "@better-auth/expo": "1.7.18",
      "@better-auth/drizzle-adapter": "^1.7.18",
      "@better-auth/electron": "^1.7.18",
      "better-auth": "^1.7.18"
    },
    "database": {
      "drizzle-kit": "^0.31.11",
      "drizzle-orm": "^0.45.4"
    }
  }
}

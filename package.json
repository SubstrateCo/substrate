{
  "name": "startup-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --no-orphans dev:server dev:web",
    "dev:server": "bun --watch apps/server/src/main.ts",
    "dev:web": "bun run --filter @startup-os/web dev",
    "dev:desktop": "bun run --filter @startup-os/desktop dev",
    "test:desktop": "bun run --filter @startup-os/desktop test:e2e",
    "build": "bun run --filter @startup-os/web build",
    "build:desktop": "bun run --filter @startup-os/desktop build",
    "build:desktop:dir": "bun run --filter @startup-os/desktop build:dir",
    "package:desktop": "bun run --filter @startup-os/desktop package",
    "test:e2e": "bun run --filter @startup-os/web test:e2e",
    "storybook": "bun run --filter @startup-os/storybook dev",
    "storybook:build": "bun run --filter @startup-os/storybook build",
    "storybook:test": "bun run --filter @startup-os/storybook test",
    "services:up": "docker compose up -d postgres mailpit s3 s3-init",
    "lint": "oxlint --type-aware --fix",
    "format": "oxfmt --write .",
    "typecheck": "bun check && turbo run typecheck",
    "test": "turbo run test",
    "test:all": "turbo run test test:e2e",
    "test:unit": "turbo run test --filter=!@startup-os/storybook",
    "db:up": "docker compose up -d postgres",
    "db:test:up": "docker compose --profile test up -d postgres-test",
    "db:generate": "bun run --filter @startup-os/database db:generate",
    "db:migrate": "bun run --filter @startup-os/database db:migrate"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.5",
    "@types/bun": "^1.4.4",
    "ai-deslop": "^0.5.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.10"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}

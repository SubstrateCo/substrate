{
  "name": "substrate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --no-orphans dev:server dev:web",
    "dev:server": "bun --watch apps/server/src/main.ts",
    "dev:web": "bun run --filter @substrate/web dev",
    "dev:desktop": "bun run --filter @substrate/desktop dev",
    "build": "bun run --filter @substrate/web build",
    "build:desktop": "bun run --filter @substrate/desktop build",
    "build:desktop:dir": "bun run --filter @substrate/desktop build:dir",
    "package:desktop": "bun run --filter @substrate/desktop package",
    "test:integration": "bun run --filter @substrate/server test:integration",
    "test:e2e": "bun run --filter @substrate/web test:e2e",
    "test:e2e:services": "docker compose --profile test up -d --wait postgres-e2e mailpit valkey",
    "services:up": "docker compose up -d postgres mailpit s3 s3-init valkey",
    "lint": "oxlint --type-aware --fix",
    "knip": "knip",
    "format": "oxfmt --write .",
    "typecheck": "bun check && turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:test:up": "docker compose --profile test up -d postgres-test",
    "db:generate": "bun run --filter @substrate/database db:generate",
    "db:migrate": "bun run --filter @substrate/database db:migrate",
    "db:seed": "bun --env-file=.env apps/server/scripts/seed-dev.ts"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.5",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/bun": "^1.4.4",
    "ai-deslop": "^0.5.2",
    "knip": "^6.44.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.10"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}

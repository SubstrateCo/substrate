{
  "name": "substrate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @substrate/desktop dev",
    "dev:server": "bun run --filter @substrate/server dev",
    "dev:web": "bun run --filter @substrate/web dev",
    "build": "bun run --filter @substrate/desktop build",
    "package:desktop": "bun run --filter @substrate/desktop package",
    "test:integration": "bun run --filter @substrate/server test:integration",
    "test:e2e": "bun run --filter @substrate/web test:e2e",
    "services:up": "docker compose up -d --wait postgres mailpit s3 s3-init valkey",
    "services:test": "docker compose --profile test up -d --wait postgres-test postgres-e2e mailpit valkey s3 s3-init",
    "lint": "oxlint --type-aware --fix",
    "knip": "knip",
    "dup:check": "jscpd --fail-on-new-clones --reporters ai",
    "dup:baseline": "jscpd --update-baseline --reporters silent",
    "format": "oxfmt --write .",
    "typecheck": "turbo run typecheck",
    "test": "bun --env-file=.env scripts/check-test-services.ts && turbo run test",
    "db:generate": "bun run --filter @substrate/database db:generate",
    "db:migrate": "bun run --filter @substrate/database db:migrate",
    "db:seed": "bun --env-file=.env apps/server/scripts/seed-dev.ts"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.5",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/bun": "^1.4.4",
    "ai-deslop": "^0.7.1",
    "jscpd": "^5",
    "knip": "^6.44.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.10"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}

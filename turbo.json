{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@substrate/web#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/contracts/package.json"
      ],
      "env": ["VITE_*"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"],
      "outputLogs": "errors-only",
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DATABASE_SHARDS",
        "DATABASE_URL",
        "TEST_VALKEY_URL",
        "VALKEY_URL",
        "REALTIME_CHANNEL"
      ],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"],
      "env": [
        "CI",
        "E2E_WORKERS",
        "E2E_RECORD_VIDEO",
        "E2E_CAPTURE_SCREENSHOTS",
        "E2E_SCREENSHOTS_DIR",
        "VITE_*"
      ],
      "passThroughEnv": ["PLAYWRIGHT_*", "E2E_DATABASE_URL"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:integration": {
      "outputLogs": "errors-only",
      "env": ["PLAYWRIGHT_BASE_URL", "MAILPIT_BASE_URL"],
      "cache": false,
      "outputs": []
    }
  }
}

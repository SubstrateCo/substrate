{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@startup-os/web#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/contracts/package.json"
      ],
      "env": ["VITE_*"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test": {
      "outputLogs": "errors-only",
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DATABASE_SHARDS",
        "DATABASE_URL",
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH"
      ],
      "cache": false,
      "outputs": []
    },
    "test:e2e": {
      "outputLogs": "errors-only",
      "env": [
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_API_URL",
        "MAILPIT_BASE_URL",
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH",
        "STARTUP_OS_WEB_URL",
        "STARTUP_OS_API_URL",
        "DESKTOP_EXECUTABLE_PATH",
        "DESKTOP_BUNDLED_RENDERER"
      ],
      "cache": false,
      "outputs": []
    }
  }
}

{
  "name": "@substrate/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./trusted": "./src/trusted.ts",
    "./authentication": "./src/core/authentication/organization-preference.ts",
    "./storage": "./src/core/storage/index.ts",
    "./messaging": "./src/features/messaging/index.ts",
    "./mcp": "./src/features/mcp/index.ts",
    "./agents": "./src/features/agents/index.ts",
    "./calendar": "./src/features/calendar/index.ts",
    "./realtime": "./src/features/realtime/index.ts",
    "./development": "./src/development/seed.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "test": "bun --env-file=../../.env src/testing/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/migrate.ts"
  },
  "dependencies": {
    "@substrate/contracts": "workspace:*",
    "drizzle-orm": "catalog:database",
    "libphonenumber-js": "^1.13.16",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:database",
    "zod": "catalog:"
  }
}

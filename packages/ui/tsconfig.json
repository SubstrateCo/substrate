{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@startup-os/ui": ["./src"],
      "@startup-os/ui/*": ["./src/*"]
    },
    "types": ["bun"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}

{
  "root": ".",
  "languages": ["typescript"],
  "include": [
    "apps/server/src/**",
    "apps/web/src/**",
    "packages/database/src/**",
    "packages/contracts/src/**"
  ],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/test-support.ts",
    "**/testing/**",
    "**/development/**",
    "packages/database/src/migrations/**"
  ],
  "entrypoints": [
    {
      "name": "rest",
      "files": ["apps/server/src/**/routes.ts", "apps/server/src/**/*-routes.ts"],
      "route": "\\.(?<method>get|post|put|patch|delete)\\(\\s*[\"'`](?<path>[^\"'`]*)[\"'`]",
      "mount": {
        "files": ["apps/server/src/app.ts"],
        "pattern": "\\.route\\(\\s*[\"'`](?<prefix>[^\"'`]+)[\"'`]\\s*,\\s*(?<factory>\\w+)\\("
      }
    }
  ],
  "layers": [
    {
      "name": "composition",
      "files": ["apps/server/src/{app,main,services}.ts"]
    },
    {
      "name": "config",
      "files": ["apps/server/src/environment.ts"]
    },
    {
      "name": "kernel",
      "files": [
        "apps/server/src/shared/{service-result,committed,workspace,content-disposition,origin-check,scope-types,export-types}.ts"
      ]
    },
    {
      "name": "route",
      "files": ["apps/server/src/**/routes.ts", "apps/server/src/**/*-routes.ts"]
    },
    {
      "name": "http",
      "files": ["apps/server/src/shared/{http,export,html-page}.ts"]
    },
    {
      "name": "middleware",
      "files": ["apps/server/src/shared/{scope,origin}.ts"]
    },
    {
      "name": "adapter",
      "files": [
        "apps/server/src/auth/**",
        "apps/server/src/mail/**",
        "apps/server/src/storage/**",
        "apps/server/src/infrastructure/database.ts",
        "apps/server/src/v1/realtime/{publisher,subscription,hub}.ts",
        "apps/server/src/v1/files/{image,image-codec}.ts"
      ]
    },
    {
      "name": "service",
      "files": ["apps/server/src/v1/**", "apps/server/src/desktop/**", "apps/server/src/shared/**"]
    },
    {
      "name": "database-client",
      "files": ["packages/database/src/{client,trusted,migrate}.ts"],
      "mayImport": ["database", "database-core", "contracts"]
    },
    {
      "name": "database-core",
      "files": ["packages/database/src/core/**", "packages/database/src/errors.ts"],
      "mayImport": ["contracts"]
    },
    {
      "name": "database",
      "files": ["packages/database/src/**"],
      "specifiers": ["^@substrate/database"],
      "mayImport": ["database-core", "contracts"]
    },
    {
      "name": "contracts",
      "files": ["packages/contracts/src/**"],
      "specifiers": ["^@substrate/contracts"],
      "mayImport": []
    },
    {
      "name": "renderer-desktop",
      "files": ["apps/web/src/lib/desktop/**"],
      "specifiers": ["^@/lib/desktop/"],
      "mayImport": ["contracts"]
    },
    {
      "name": "renderer-api",
      "files": ["apps/web/src/api/**"],
      "specifiers": ["^@/api/"],
      "mayImport": ["contracts", "renderer-desktop"]
    },
    {
      "name": "renderer-lib",
      "files": ["apps/web/src/lib/**"],
      "specifiers": ["^@/lib/"],
      "mayImport": ["contracts", "renderer-desktop", "renderer-api"]
    },
    {
      "name": "renderer-queries",
      "files": ["apps/web/src/queries/**"],
      "specifiers": ["^@/queries/"],
      "mayImport": ["contracts", "renderer-desktop", "renderer-api", "renderer-lib"]
    },
    {
      "name": "renderer",
      "files": ["apps/web/src/**"],
      "specifiers": ["^@/"],
      "mayImport": [
        "contracts",
        "renderer-desktop",
        "renderer-api",
        "renderer-lib",
        "renderer-queries"
      ]
    }
  ],
  "rules": [
    {
      "id": "R1",
      "tag": "bypass",
      "layer": "route",
      "forbidImports": [
        "database",
        "database-core",
        "database-client",
        "adapter",
        "3p:drizzle-orm",
        "3p:postgres"
      ],
      "message": "route imports {target} ({match})",
      "fix": "Call a service method; the service owns repositories and adapters"
    },
    {
      "id": "R1",
      "tag": "bypass",
      "layer": "route",
      "forbidMembers": ["repositories.*"],
      "forbidCalls": ["db.{select,insert,update,delete,execute,transaction}"],
      "message": "route uses persistence directly (`{match}`)",
      "fix": "Move the call into a service method"
    },
    {
      "id": "R3",
      "tag": "validate",
      "layer": "route",
      "forbidCalls": ["*.req.{json,parseBody,formData,text,arrayBuffer,blob,query,param,header}"],
      "message": "route reads raw request input (`{match}`)",
      "fix": "Validate with v(target, schema) from shared/http and read c.req.valid(target)"
    },
    {
      "id": "R4",
      "tag": "sanitize",
      "layer": "route",
      "forbidCalls": ["c.{json,text,status}"],
      "forbidNew": ["Response"],
      "forbidSyntax": ["CatchClause"],
      "message": "route shapes the response or error itself (`{match}`)",
      "fix": "Return a ServiceResult and map it with respond(c, result)"
    },
    {
      "id": "R5",
      "tag": "vendor",
      "layer": "route",
      "forbidImports": ["/^3p:(?!hono$|@hono\\/|zod$)/"],
      "message": "route imports third-party {target}",
      "fix": "Wrap the SDK in an adapter and call it from a service"
    },
    {
      "id": "S1",
      "tag": "upward",
      "layer": "service",
      "forbidImports": ["route", "composition", "3p:hono", "/^3p:@hono\\//"],
      "allowTypeOnly": true,
      "message": "service imports {target} ({match})",
      "fix": "Take plain inputs and return ServiceResult; keep HTTP types in routes"
    },
    {
      "id": "S1",
      "tag": "upward",
      "layer": "service",
      "forbidMembers": ["*.req"],
      "forbidNew": ["Response", "HTTPException"],
      "message": "service handles HTTP (`{match}`)",
      "fix": "Return a ServiceError code; respond() maps it to HTTP"
    },
    {
      "id": "S2",
      "tag": "bypass",
      "layer": "service",
      "forbidImports": ["3p:drizzle-orm", "3p:postgres", "/^@substrate\\/database\\/schema/"],
      "allowTypeOnly": true,
      "message": "service imports query tools ({match})",
      "fix": "Add a repository method in packages/database and call it"
    },
    {
      "id": "S4",
      "tag": "vendor",
      "layer": "service",
      "forbidImports": ["/^3p:(@aws-sdk\\/|nodemailer$|sharp$|ioredis$|redis$)/"],
      "message": "service imports SDK {target} directly",
      "fix": "Inject an adapter interface from services.ts"
    },
    {
      "id": "D1",
      "tag": "validate",
      "layer": ["database-client", "database-core", "database"],
      "forbidImports": ["3p:zod", "/^@substrate\\/contracts\\/.*input$/"],
      "allowTypeOnly": true,
      "message": "database imports runtime validation ({match})",
      "fix": "Validate shape in the route and domain rules in the service; pass parsed values"
    },
    {
      "id": "D1",
      "tag": "validate",
      "layer": ["database-client", "database-core", "database"],
      "forbidCalls": ["**.safeParse", "*{Schema,Input,Request}.parse"],
      "message": "database parses input (`{match}`)",
      "fix": "Move parsing to the route; the repository accepts typed values"
    },
    {
      "id": "D3",
      "tag": "upward",
      "layer": ["database-client", "database-core", "database"],
      "forbidImports": ["3p:hono", "/^3p:@hono\\//", "3p:better-auth"],
      "message": "database imports {target} ({match})",
      "fix": "Invert the dependency; the caller passes values in"
    },
    {
      "id": "D4",
      "tag": "vendor",
      "layer": ["database-client", "database-core", "database"],
      "forbidImports": ["/^3p:(?!drizzle-orm$|postgres$|zod$|libphonenumber-js$)/"],
      "allowTypeOnly": true,
      "message": "database imports non-persistence {target}",
      "fix": "Call the SDK from a service or adapter"
    },
    {
      "id": "P1",
      "tag": "bypass",
      "layer": "database",
      "forbidCalls": [
        "{adminRoleCondition,organizationAdminCondition,isOrganizationAdmin,entityAccessLevel,readableCondition}"
      ],
      "message": "feature builds its own permission check (`{match}()`)",
      "fix": "Use RepositoryContext (requireAccess(id, minimum, { type }), readable(id, minimum, type), accessLevel, actorsWithAccess, requireOrganizationAdmin, deny) or entityReaders for fan-out; register type rules in packages/contracts/src/<domain>/access.ts"
    },
    {
      "id": "C1",
      "tag": "upward",
      "layer": "contracts",
      "forbidImports": ["/^3p:(?!zod$)/"],
      "message": "browser-safe contracts import {target} ({match})",
      "fix": "Keep contracts to schemas and types; move server code out"
    },
    {
      "id": "W1",
      "tag": "upward",
      "layer": ["renderer", "renderer-queries", "renderer-lib", "renderer-api", "renderer-desktop"],
      "forbidImports": ["/^@substrate\\/server/"],
      "allowTypeOnly": true,
      "message": "renderer imports server runtime code ({match})",
      "fix": "Import server types with `import type` and call the server through the hc client in src/api"
    },
    {
      "id": "W2",
      "tag": "bypass",
      "layer": ["renderer", "renderer-queries", "renderer-lib", "renderer-api", "renderer-desktop"],
      "forbidImports": [
        "database",
        "database-core",
        "database-client",
        "3p:drizzle-orm",
        "3p:postgres"
      ],
      "message": "renderer imports {target} ({match})",
      "fix": "Keep database access on the server; share browser-safe contracts through @substrate/contracts"
    },
    {
      "id": "W3",
      "tag": "move",
      "layer": ["renderer", "renderer-queries", "renderer-lib", "renderer-api", "renderer-desktop"],
      "forbidSyntax": ["ImportExpression"],
      "message": "renderer uses a dynamic import()",
      "fix": "Use a static import; fix the dependency injection, server-only boundary, or import configuration instead of bypassing it"
    },
    {
      "id": "W4",
      "tag": "move",
      "layer": ["renderer", "renderer-lib", "renderer-api", "renderer-desktop"],
      "forbidCalls": ["{queryOptions,infiniteQueryOptions}"],
      "message": "{target} defines query options (`{match}()`)",
      "fix": "Put reusable query option factories in src/queries/<domain>/ and use the shared query-key factory"
    },
    {
      "id": "W5",
      "tag": "bypass",
      "layer": ["renderer", "renderer-queries", "renderer-lib", "renderer-desktop"],
      "forbidImports": ["/^hono\\/client$/"],
      "forbidCalls": ["hc"],
      "message": "{target} builds an RPC client ({match})",
      "fix": "Use the hc client from src/api"
    }
  ],
  "exceptions": [
    {
      "rule": "R4",
      "files": ["apps/server/src/desktop/routes.ts"],
      "reason": "The /desktop/open handoff returns HTML and redirects, not the result envelope."
    },
    {
      "rule": "D1",
      "files": ["packages/database/src/**"],
      "reason": "Repositories are the shared trust boundary for HTTP and MCP callers and own their input contracts (packages/database/AGENTS.md)."
    },
    {
      "rule": "R1",
      "files": ["apps/server/src/v1/realtime/routes.ts"],
      "reason": "WebSocket upgrade transport; type-only RealtimeHub import drives the hub adapter's connection lifecycle."
    },
    {
      "rule": "R3",
      "files": ["apps/server/src/v1/realtime/routes.ts"],
      "reason": "The upgrade handshake reads Origin and Upgrade headers; it mounts before trustedOrigin middleware, which skips GET."
    },
    {
      "rule": "R4",
      "files": ["apps/server/src/v1/realtime/routes.ts"],
      "reason": "Handshake rejections (400/403/426/503) have no body; WebSocket clients cannot read the result envelope."
    },
    {
      "rule": "P1",
      "files": ["packages/database/src/features/tasks/assignment.ts"],
      "reason": "The assignee is another actor: their level on the project is checked with the visibility check in one statement."
    },
    {
      "rule": "P1",
      "files": ["packages/database/src/features/messaging/access.ts"],
      "reason": "Task discussions join conversation rows to the task's level in the set-based visibleConversations query."
    },
    {
      "rule": "P1",
      "files": ["packages/database/src/features/notifications/effects.ts"],
      "reason": "Notification fan-out filters recipient actor columns by readability, one row per recipient."
    },
    {
      "rule": "P1",
      "files": ["packages/database/src/features/messaging/sharing/access.ts"],
      "reason": "Cross-organization approval reads the user's role in another organization, where the session has no actor."
    },
    {
      "rule": "C1",
      "files": ["packages/contracts/src/auth/permissions.ts"],
      "reason": "Role definitions are shared by the server and the renderer's organization client; better-auth/plugins/access is pure and browser-safe."
    }
  ]
}
